<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ass3 pra7"/>
        <attribute name="authors" value="StatLab"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-29 01:22:21 PM"/>
        <attribute name="created" value="U3RhdExhYjtERVNLVE9QLURWRVFERjY7MjAyNi0wNy0yOTsxMjo1Njo0MSBQTTszMDUz"/>
        <attribute name="edited" value="U3RhdExhYjtERVNLVE9QLURWRVFERjY7MjAyNi0wNy0yOTswMToyMjoyMSBQTTsyOzMxNTE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="number, b" type="Integer" array="False" size=""/>
            <output expression="&quot;enter a number&quot;" newline="True"/>
            <input variable="number"/>
            <assign variable="b" expression="number%5"/>
            <if expression="b=1">
                <then>
                    <output expression="&quot;number is divisible by 5&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;number is not divisible by 5&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
